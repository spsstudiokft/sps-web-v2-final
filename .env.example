# .env.example

# ==========================================
# 1. Database Configuration (Turso / LibSQL / SQLite)
# ==========================================
# For production on Vercel, use a remote Turso / LibSQL database URL (libsql:// or https://)
# For local development, 'file:local.db' is used by default.
DATABASE_URL=libsql://your-database-name-organization.turso.io
DATABASE_AUTH_TOKEN=your-turso-database-auth-token

# Legacy / Alternative aliases (also supported automatically):
# TURSO_DATABASE_URL=libsql://your-database-name-organization.turso.io
# TURSO_AUTH_TOKEN=your-turso-database-auth-token

# ==========================================
# 2. Authentication & Application Secrets
# ==========================================
# Secure random string for signing JWT tokens (Required for session security)
JWT_SECRET=your-random-secure-jwt-secret-string
# At least 32 random characters. Keep stable: changing it makes enrolled
# authenticator secrets unreadable. Configure separately on Vercel environments.
MFA_ENCRYPTION_KEY=your-dedicated-random-mfa-encryption-key
MFA_TOTP_ISSUER=SPS Studio

# Public canonical URL of the deployed application (used for email invitation and reset links)
# Example: https://spsstudio.vercel.app or https://yourdomain.com
APP_URL=https://your-domain.vercel.app

# Google Analytics 4 dashboard (server-side only; never expose this JSON in the browser)
# GOOGLE_ANALYTICS_PROPERTY_ID=123456789
# GOOGLE_ANALYTICS_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"analytics-reader@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}

# ==========================================
# 3. Media Storage (Cloudflare R2 / Appwrite / Local)
# ==========================================
# Media provider: "r2", "appwrite", or "local"
MEDIA_PROVIDER=r2

# Cloudflare R2 Credentials (when MEDIA_PROVIDER=r2)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_DOMAIN=https://your-r2-custom-domain.com

# Appwrite Storage (when MEDIA_PROVIDER=appwrite)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_API_KEY=your-appwrite-api-key
APPWRITE_BUCKET_ID=your-appwrite-bucket-id

# ==========================================
# 4. Email Service (Resend Integration)
# ==========================================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=SPS Studio
RESEND_REPLY_TO=contact@spsstudio.com

# Stripe billing: sandbox/test mode only. Keep this secret server-side.
# Enable the feature afterwards in Admin Settings as Superadmin.
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key

# ==========================================
# 5. AI Capabilities (Optional Gemini API)
# ==========================================
GEMINI_API_KEY=
# Secret used by Vercel Cron to invoke the calendar reminder worker.
# Set the same random value (at least 16 characters) in the production environment.
CRON_SECRET=
# Synology shared media library (server-side only; never expose these values in VITE_ variables)
SYNOLOGY_MEDIA_BASE_URL=https://your-nas.example.com:5001
SYNOLOGY_MEDIA_USERNAME=sps_media_service
SYNOLOGY_MEDIA_PASSWORD=replace-with-a-strong-service-password
SYNOLOGY_MEDIA_SHARED_ROOT=/SPS-Media
# JSON: explicit folder grants for video editors, keyed by SPS user ID or email.
# Each value must be an array, so one editor can receive one or more folders.
# Copyable example:
# {"vago@pelda.hu":["/SPS-Media/Vagok/vago"],"felhasznalo-azonosito":["/SPS-Media/Vagok/masik-vago","/SPS-Media/Kozos"]}
SYNOLOGY_MEDIA_EDITOR_ROOTS_JSON={"editor@example.com":["/SPS-Media/Editing/editor"]}
# Optional NAS Docker download gateway. If both values are configured, downloads
# stream directly from the NAS without QuickConnect/DSM landing-page redirects.
SYNOLOGY_MEDIA_DOWNLOAD_GATEWAY_URL=https://media-download.example.com
SYNOLOGY_MEDIA_DOWNLOAD_SIGNING_SECRET=replace-with-a-separate-random-32-byte-secret
