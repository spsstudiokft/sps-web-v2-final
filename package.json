{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.4",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --minify --legal-comments=none --sourcemap --log-level=error --outfile=dist/server.cjs",
    "build:vercel": "vite build && node scripts/prepare-vercel-output.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --minify --legal-comments=none --sourcemap --log-level=error --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "migrate:translations": "tsx scripts/migrate-translations.ts",
    "audit:i18n": "tsx scripts/audit-i18n.ts",
    "audit:i18n:admin": "tsx scripts/audit-admin-static-i18n.ts",
    "audit:i18n:admin:matches": "tsx scripts/analyze-admin-translation-matches.ts",
    "i18n:admin:wire-existing": "tsx scripts/wire-existing-admin-translations.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/lib-storage": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "3.1089.0",
