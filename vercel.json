{
  "framework": "vite",
  "functions": {
    "api/public.ts": { "maxDuration": 60 },
    "api/auth.ts": { "maxDuration": 60 },
    "api/admin.ts": { "maxDuration": 300 },
    "api/client.ts": { "maxDuration": 300 },
    "api/system.ts": { "maxDuration": 30 },
    "api/budgets.ts": { "maxDuration": 120 },
    "api/invoices.ts": { "maxDuration": 120 },
    "api/payment-requests.ts": { "maxDuration": 300 },
    "api/referrals.ts": { "maxDuration": 120 },
    "api/public-invoices.ts": { "maxDuration": 60 },
    "api/public-referrals.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/budgets/:match*",
      "destination": "/api/budgets.ts"
    },
    {
      "source": "/api/admin/invoices/:match*",
      "destination": "/api/invoices.ts"
    },
    {
      "source": "/api/admin/payment-requests/:match*",
      "destination": "/api/payment-requests.ts"
    },
    {
      "source": "/api/admin/referrals/:match*",
      "destination": "/api/referrals.ts"
    },
    {
      "source": "/api/health",
      "destination": "/api/system.ts"
    },
    {
      "source": "/api/status-summary",
      "destination": "/api/system.ts"
    },
    {
      "source": "/api/admin/:match*",
      "destination": "/api/admin.ts"
    },
    {
      "source": "/api/client/:match*",
      "destination": "/api/client.ts"
    },
    {
      "source": "/api/auth/:match*",
      "destination": "/api/auth.ts"
    },
    {
      "source": "/api/invitations/:match*",
      "destination": "/api/auth.ts"
    },
    {
      "source": "/api/setup/:match*",
      "destination": "/api/auth.ts"
    },
    {
      "source": "/api/setup",
      "destination": "/api/auth.ts"
    },
    {
      "source": "/api/public/invoices/:match*",
      "destination": "/api/public-invoices.ts"
    },
    {
      "source": "/api/public/referrals/:match*",
      "destination": "/api/public-referrals.ts"
    },
    {
      "source": "/api/public/:match*",
      "destination": "/api/public.ts"
    },
    {
      "source": "/((?!api/|api$).*)",
      "destination": "/index.html"
    }
  ]
}
