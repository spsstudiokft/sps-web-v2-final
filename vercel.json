{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build:vercel",
  "images": {
    "domains": [],
    "sizes": [96, 128, 192, 320, 480, 640, 768, 840, 1024, 1440, 1920],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "appwrite.summerfall.synology.me",
        "pathname": "^/v1/storage/buckets/spsmainweb/files/.*$"
      }
    ],
    "minimumCacheTTL": 86400,
    "qualities": [76, 82, 84, 88],
    "formats": ["image/avif", "image/webp"],
    "dangerouslyAllowSVG": false,
    "contentSecurityPolicy": "script-src 'none'; frame-src 'none'; sandbox;",
    "contentDispositionType": "inline"
  },
  "functions": {
    "api/home.ts": { "maxDuration": 60, "includeFiles": "dist/app-shell.html" },
    "api/cron-calendar.ts": { "maxDuration": 60 },
    "api/public.ts": { "maxDuration": 60 },
    "api/auth.ts": { "maxDuration": 60 },
    "api/admin.ts": { "maxDuration": 300 },
    "api/client.ts": { "maxDuration": 300 },
    "api/property-manager.ts": { "maxDuration": 300 },
    "api/system.ts": { "maxDuration": 30 },
    "api/budgets.ts": { "maxDuration": 120 },
    "api/invoices.ts": { "maxDuration": 120 },
    "api/payment-requests.ts": { "maxDuration": 300 },
    "api/referrals.ts": { "maxDuration": 120 },
    "api/public-invoices.ts": { "maxDuration": 60 },
    "api/public-referrals.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron-calendar", "schedule": "* * * * *" }
  ],
  "redirects": [
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/contact/:path*",
      "destination": "/#contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/149e9513-01fa-4fb0-aad4-566afd725d1b/2d206a39-8ed7-437e-a3be-862e0f06eea3/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/149e9513-01fa-4fb0-aad4-566afd725d1b/2d206a39-8ed7-437e-a3be-862e0f06eea3/a-4-a/c.js",
      "destination": "https://api.vercel.com/bot-protection/v1/challenge"
    },
    {
      "source": "/149e9513-01fa-4fb0-aad4-566afd725d1b/2d206a39-8ed7-437e-a3be-862e0f06eea3/:path*",
      "destination": "https://api.vercel.com/bot-protection/v1/proxy/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/public/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/public/sitemap.xml"
    },
    {
      "source": "/api/admin/budgets/:match*",
      "destination": "/api/budgets.ts"
    },
    {
      "source": "/api/admin/invoices/:match*",
      "destination": "/api/invoices.ts"
    },
    {
      "source": "/api/admin/payment-requests/:match*",
      "destination": "/api/payment-requests.ts"
    },
    {
      "source": "/api/admin/referrals/:match*",
      "destination": "/api/referrals.ts"
    },
    {
      "source": "/api/health",
      "destination": "/api/system.ts"
    },
    {
      "source": "/api/status-summary",
      "destination": "/api/system.ts"
    },
    {
      "source": "/api/admin/:match*",
      "destination": "/api/admin.ts"
    },
    {
      "source": "/api/client/:match*",
      "destination": "/api/client.ts"
    },
    {
      "source": "/api/property-manager/:match*",
      "destination": "/api/property-manager.ts"
    },
    {
      "source": "/api/property-auth/:match*",
      "destination": "/api/auth.ts"
    },
    {
      "source": "/api/auth/:match*",
      "destination": "/api/auth.ts"
    },
    {
      "source": "/api/invitations/:match*",
      "destination": "/api/auth.ts"
    },
    {
      "source": "/api/setup/:match*",
      "destination": "/api/auth.ts"
    },
    {
      "source": "/api/setup",
      "destination": "/api/auth.ts"
    },
    {
      "source": "/api/public/invoices/:match*",
      "destination": "/api/public-invoices.ts"
    },
    {
      "source": "/api/public/referrals/:match*",
      "destination": "/api/public-referrals.ts"
    },
    {
      "source": "/api/public/:match*",
      "destination": "/api/public.ts"
    },
    {
      "source": "/((?!api/|api$).*)",
      "destination": "/app-shell.html"
    }
  ]
}
